<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Google Play only lets a subscription product be created once an
         uploaded build declares this permission; the Play Billing library
         behind purchases_flutter merges it in as well, but declaring it
         here keeps that requirement visible. -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- The receipt scanner drives the camera itself (auto-capture); the system camera app needs none. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Talking to the in-app assistant: the device's speech recognizer
         turns speech into text; nothing is recorded by the app. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 13+: without this the runtime prompt cannot be granted and every push is dropped silently. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Cook-mode timers ring at the second they end; granted by the user on
         Android 14+, with an inexact fallback when it is not. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- While a cook-mode timer runs, a foreground service keeps the app's
         Dart side alive in the background so the timer notifications keep
         moving. Special use: a kitchen timer, declared as such to Play. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application
        android:label="Easy Plate"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Share links: the router reads the path (/s/CODE) and opens
                 the join screen. The https filter opens automatically only
                 once assetlinks.json is published on the domain; until then
                 the landing page's "open in app" button uses the scheme. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="easyplate" android:host="open" android:pathPrefix="/s/" />
            </intent-filter>
            <!-- A home-screen widget's tap: easyplate://open/widget/<action>,
                 handled by the router like any other link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="easyplate" android:host="open" android:pathPrefix="/widget/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="aieasyplate.app" android:pathPrefix="/s/" />
            </intent-filter>
            <!-- The share sheet: a recording or voice note, a recipe PDF, or
                 a link / pasted text, handed straight to the ingestion
                 screen (see ShareIntentService). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Several at once: a voice note that came in parts. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- AdMob *App* ID (the one with a tilde), not an ad unit. The SDK
             refuses to initialise without it. This is Google's sample App ID;
             replace it with the EasyPlate Android App ID from the AdMob
             console before a store build. Ad *unit* IDs come from
             dart_defines/dev.json, see lib/core/constants/ads_config.dart. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <!-- Home-screen widgets (widgets/): four providers, the two
             services that feed their scrolling rows, the receiver a tick
             on a row broadcasts to, the quick-add dialog and the per-widget
             settings dialog. Data flows through a SharedPreferences file
             the Dart side fills over the easy_plate/home_widgets channel. -->
        <receiver
            android:name=".widgets.AssistantWidgetProvider"
            android:exported="true"
            android:label="@string/epw_assistant_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/epw_assistant_info" />
        </receiver>
        <receiver
            android:name=".widgets.GroceryAddWidgetProvider"
            android:exported="true"
            android:label="@string/epw_grocery_add_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/epw_grocery_add_info" />
        </receiver>
        <receiver
            android:name=".widgets.GroceryListWidgetProvider"
            android:exported="true"
            android:label="@string/epw_grocery_list_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/epw_grocery_list_info" />
        </receiver>
        <receiver
            android:name=".widgets.TodayMenuWidgetProvider"
            android:exported="true"
            android:label="@string/epw_today_menu_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/epw_today_menu_info" />
        </receiver>
        <receiver android:name=".widgets.WidgetActionReceiver" android:exported="false" />
        <service
            android:name=".widgets.GroceryItemsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <service
            android:name=".widgets.TodayMealsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <activity
            android:name=".widgets.WidgetQuickAddActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/EasyPlateWidgetDialog"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
        <activity
            android:name=".widgets.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/EasyPlateWidgetDialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- flutter_foreground_task: the name must stay exactly this. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="cooking_timer" />
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Android 11+: the speech recognizer and text-to-speech engines
             are other packages, invisible unless declared. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- The widgets' quick-add dialog dictates through the system's
             speech activity, another package on Android 11+. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ hides other packages unless they are declared here, so
             without these the support screen's launchUrl finds no handler for
             WhatsApp or for an email client. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
