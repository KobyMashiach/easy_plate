<?xml version="1.0" encoding="utf-8"?>
<!-- The quick-add and widget-settings dialogs: floating, no title, the
     card drawn by the activity so the corners and colours follow the
     widget's own look rather than the phone's night mode. -->
<resources>
    <style name="EasyPlateWidgetDialog" parent="@android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:colorAccent">@color/epw_light_primary</item>
    </style>
    <style name="EasyPlateWidgetDialogDark" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:colorAccent">@color/epw_dark_primary</item>
    </style>
</resources>
