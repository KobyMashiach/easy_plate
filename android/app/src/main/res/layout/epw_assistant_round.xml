<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/epw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/epw_shefi_round">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="@string/epw_ask_shefi"
            android:src="@drawable/epw_ic_sparkle"
            android:tint="@color/epw_light_on_primary" />
    </FrameLayout>
</FrameLayout>
