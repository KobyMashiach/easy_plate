<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/epw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/epw_card_light"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/epw_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/epw_ic_cart" />
        <LinearLayout
            android:id="@+id/epw_title_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/epw_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/epw_grocery_list_label"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/epw_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="1/3"
            android:textSize="12sp" />
        <FrameLayout
            android:id="@+id/epw_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/epw_round_primary_light">
            <ImageView
                android:id="@+id/epw_add_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/epw_quick_add"
                android:src="@drawable/epw_ic_add" />
        </FrameLayout>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/epw_progress_light"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="1"
        android:progress="0"
        android:progressDrawable="@drawable/epw_track_light" />
    <ProgressBar
        android:id="@+id/epw_progress_dark"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="1"
        android:progress="0"
        android:progressDrawable="@drawable/epw_track_dark"
        android:visibility="gone" />
    <ListView
        android:id="@+id/epw_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />
    <TextView
        android:id="@+id/epw_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/epw_empty_list"
        android:textSize="13sp" />
</LinearLayout>
