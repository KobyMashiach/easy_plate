<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/epw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:background="@drawable/epw_round_primary_light">
    <ImageView
        android:id="@+id/epw_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center"
        android:contentDescription="@string/epw_quick_add"
        android:src="@drawable/epw_ic_add"
        android:tint="@color/epw_light_on_primary" />
</FrameLayout>
