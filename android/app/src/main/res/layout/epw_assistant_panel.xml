<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/epw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/epw_card_light"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
    <LinearLayout
        android:id="@+id/epw_pill"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/epw_shefi_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/epw_white_circle">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/epw_ic_sparkle"
                android:tint="@color/epw_light_on_primary" />
        </FrameLayout>
        <TextView
            android:id="@+id/epw_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/epw_ask_shefi"
            android:textColor="@color/epw_light_on_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
        <TextView
            android:id="@+id/epw_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/epw_tap_to_ask"
            android:textSize="13sp" />
        <FrameLayout
            android:id="@+id/epw_mic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/epw_round_soft_light">
            <ImageView
                android:id="@+id/epw_mic_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/epw_speak"
                android:src="@drawable/epw_ic_mic" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">
    <TextView
        android:id="@+id/epw_chip1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/epw_chip_light"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text="@string/epw_prompt_sample"
        android:textColor="@color/epw_light_on_primary_fixed"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/epw_chip2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/epw_chip_light"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text="@string/epw_prompt_sample"
        android:textColor="@color/epw_light_on_primary_fixed"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/epw_chip3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/epw_chip_light"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text="@string/epw_prompt_sample"
        android:textColor="@color/epw_light_on_primary_fixed"
        android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
