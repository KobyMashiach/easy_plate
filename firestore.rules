rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // A profile document is private to its owner. The id is the Firebase Auth
    // uid, so ownership is the document path itself.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Nothing else is reachable until it has a rule of its own.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
