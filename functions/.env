# Non-secret settings for the WhatsApp grocery bot (whatsappBot.js).
# Fill both from Meta's WhatsApp Manager, then redeploy whatsappWebhook + whatsappLink.
# WHATSAPP_PHONE_NUMBER_ID: the "Phone number ID" (API Setup page), not the phone number.
# WHATSAPP_BOT_NUMBER: the bot's own number, digits only, e.g. 972501234567 (for wa.me links).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BOT_NUMBER=
