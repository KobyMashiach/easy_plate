rules_version = '2';

// Deploy with:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    // One object per user, at a fixed path, so replacing a photo overwrites
    // rather than accumulating. Capped so the bucket cannot be used as free
    // hosting.
    match /profile_photos/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
